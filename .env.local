# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL= https://fkrjygmojetjidnaalrp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= sb_publishable_ngUVS-aooF96pmaeVPV9Bw_BNl20jNC
SUPABASE_SERVICE_ROLE_KEY= sb_secret_p8RAeno2NpWzboOODiHEtA_GWCvSHBT   # server and CLI only; never NEXT_PUBLIC_

# Same value as the ORBIT_ADMIN_TOKEN secret on your Supabase Edge Functions.
# Unlocks the staff console at /launch and lets the server call admin actions.
ORBIT_ADMIN_TOKEN= ThomasPolchies

# Your root domain. Schools always work at /<slug> (localhost:3000/ua, orbit.vercel.app/ua);
# with your own domain on Vercel they also get <slug>.<root>. Use "localhost" in development.
ORBIT_ROOT_DOMAIN=localhost
ORBIT_APP_URL=http://localhost:3000
ORBIT_REVALIDATE_SECRET=            # any long random string

# Vercel (optional until you deploy)
VERCEL_TOKEN=                       # Account Settings → Tokens
VERCEL_PROJECT_ID=                  # Project → Settings → General
VERCEL_TEAM_ID=                     # only if the project is under a team
GLOBAL_CONFIG_ID=                   # ecfg_... (Storage → Global Config)
# GLOBAL_CONFIG is added automatically when you connect the store to the project

# Local test database (for npm run test:isolation)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
